# ==============================================================================
# WIN PROFESSIONAL ACADEMY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your environment-specific values.
# NEVER commit the actual .env file with real credentials to version control.
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# PostgreSQL Database Connection URL
# Local SQLite fallback: sqlite:///db.sqlite3
# Local PostgreSQL: postgres://postgres:postgres@localhost:5432/win_academy_db
# Render PostgreSQL: Render automatically provides this via DATABASE_URL
DATABASE_URL=sqlite:///db.sqlite3

# ==============================================================================
# Persistent S3-Compatible Object Storage (Cloudflare R2 / AWS S3 / Backblaze B2)
# When USE_S3_STORAGE=True, all uploaded PDFs, notes, books, and images are stored
# persistently in object storage rather than the ephemeral application filesystem.
# ==============================================================================
USE_S3_STORAGE=False

# Example Cloudflare R2 Settings (10 GB Free Tier per month with 0 egress fees):
# STORAGE_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key_id
# STORAGE_SECRET_KEY=your_r2_secret_access_key
# STORAGE_BUCKET_NAME=win-academy-media
# STORAGE_REGION=auto
# STORAGE_CUSTOM_DOMAIN=media.winacademy.edu.in (Optional)

# Example AWS S3 Settings (5 GB Free Tier):
# STORAGE_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# STORAGE_ACCESS_KEY=your_aws_access_key_id
# STORAGE_SECRET_KEY=your_aws_secret_access_key
# STORAGE_BUCKET_NAME=win-academy-media
# STORAGE_REGION=ap-south-1

# Example Backblaze B2 Settings (10 GB Free Tier):
# STORAGE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# STORAGE_ACCESS_KEY=your_b2_key_id
# STORAGE_SECRET_KEY=your_b2_application_key
# STORAGE_BUCKET_NAME=win-academy-media
# STORAGE_REGION=us-west-004

# ==============================================================================
# Initial Superuser Creation (Optional for automated Docker / CI deployment)
# ==============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@winacademy.edu.in
DJANGO_SUPERUSER_PASSWORD=ChangeThisStrongAdminPassword2026!

# Production SSL & Security Settings (Auto-enabled when DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
